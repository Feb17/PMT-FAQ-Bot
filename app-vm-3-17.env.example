# ===== Remote infrastructure on xe9680 =====
XE9680_HOST=10.203.97.4
QDRANT_URL=http://10.203.97.4:6333
EMBEDDING_URL=http://10.203.97.4:8001
RERANK_URL=http://10.203.97.4:8002
LLM_URL=http://10.203.97.4:8000

# Keep the same value as infra-xe9680 .env.
QDRANT_API_KEY=YOUR_QDRANT_API_KEY_HERE

# ===== RAG API =====
PMT_FAQ_BOT_IMAGE=pmt_faq_bot:latest
PMT_FAQ_BOT_CONTAINER_NAME=pmt_faq_bot
RAG_API_BIND_HOST=127.0.0.1
RAG_API_DEBUG_PORT=8090

COLLECTION_NAME=PMT-FAQ
RAG_MODEL_NAME=pmt_faq_bot
LLM_MODEL=Qwen3-235B-A22B-Instruct-2507
EMBED_DIM=0
ENABLE_BM25=true
RAG_SCORE_THRESHOLD=0.3
HISTORY_MAX_TURNS=4
RAG_ASSET_DIR=/data/export

# Change this to the VM hostname/IP if users access Open WebUI from another machine.
RAG_ASSET_BASE_URL=http://127.0.0.1:8090/assets/confluence
MAX_IMAGES_PER_ANSWER=3

# ===== Optional ingest job =====
# Must point to the full Confluence export root containing documents/, assets/,
# manifest.jsonl, and image_manifest.jsonl.
EXPORT_DIR=./export
DOCUMENTS_DIR=./confluence_documents
INGEST_SOURCE_DIR=/data/export/documents
LOG_DIR=./logs
INGEST_MODE=auto
BATCH_SIZE=128

# ===== Optional image processing job =====
PMT_FAQ_BOT_INGEST_CONTAINER_NAME=pmt_faq_bot_ingest
PMT_FAQ_BOT_IMAGE_PROCESS_CONTAINER_NAME=pmt_faq_bot_image_process
IMAGE_OCR_ENGINE=paddleocr
IMAGE_OCR_VERSION=unknown
IMAGE_VLM_URL=http://10.203.97.4:8000
IMAGE_CAPTION_MODEL=Qwen/Qwen3-VL-4B-Instruct
IMAGE_VLM_TIMEOUT=120

# ===== Open WebUI =====
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
OPEN_WEBUI_CONTAINER_NAME=pmt-faq-open-webui
OPEN_WEBUI_BIND_HOST=0.0.0.0
WEBUI_PORT=3000

# open-webui and pmt_faq_bot are in the same Docker network, so use the service name.
OPENAI_API_BASE_URLS=http://10.203.97.4:8000/v1;http://pmt_faq_bot:8088/v1
OPENAI_API_KEYS=none;none
WEBUI_AUTH=false
