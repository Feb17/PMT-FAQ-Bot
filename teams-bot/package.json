{
  "name": "teams-bot",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package:teams": "node scripts/package-teams-app.mjs"
  },
  "dependencies": {
    "@microsoft/agents-hosting": "1.5.3",
    "@microsoft/agents-hosting-extensions-teams": "1.5.3",
    "dotenv": "16.4.5",
    "express": "4.22.2"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "22.15.29",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
